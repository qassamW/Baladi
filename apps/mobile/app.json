{
  "expo": {
    "name": "بلدي",
    "slug": "baladi",
    "scheme": "baladi",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"photosPermission": "نحتاج الوصول إلى الصور لإرفاق صورة بالبلاغ.", "cameraPermission": "نحتاج استخدام الكاميرا لتصوير المشكلة."}],
      ["expo-location", {"locationWhenInUsePermission": "نحتاج موقعك لتحديد مكان المشكلة في البلاغ."}]
    ],
    "ios": {"supportsTablet": false},
    "android": {"usesCleartextTraffic": true},
    "web": {"output": "static"},
    "experiments": {"typedRoutes": true}
  }
}
